# Copie este arquivo para .streamlit/secrets.toml (uso local) e preencha.
# Em produção (Streamlit Community Cloud), cole o mesmo conteúdo em
# App settings -> Secrets. NUNCA suba secrets.toml real para o GitHub.

SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_KEY = "sua-chave-anon-ou-publishable-aqui"

# URL pública do app já publicado (usada para montar o link dentro do QR Code).
# Exemplo depois do deploy: "https://checklist-producao.streamlit.app"
APP_BASE_URL = "https://checklist-producao.streamlit.app"
